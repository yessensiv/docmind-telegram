# Telegram AI Assistant: local demo mode.
DEMO_MODE=true
MAX_MESSAGE_LENGTH=4000
LOG_LEVEL=INFO
OPENAI_MODEL_DEFAULT=gpt-6-luna
MAX_REQUEST_COST_USD=0.02
DAILY_BUDGET_USD=1.00
REQUIRE_CONFIRMATION_ABOVE_USD=0.01
OPENAI_TIMEOUT_SECONDS=20
MAX_INPUT_TOKENS=4000
MAX_OUTPUT_TOKENS=500
MAX_QUESTION_LENGTH=1000
MAX_ANSWER_LENGTH=2000
DOCUMENT_TTL_SECONDS=1800

# Required only when connecting the Telegram adapter; read from the environment.
TELEGRAM_BOT_TOKEN=
# Required only when DEMO_MODE=false. Never commit a real key.
OPENAI_API_KEY=
